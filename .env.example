# 复制成 .env 后按需修改（不改也能跑）

# 服务端口
HL_PORT=8080

# 是否启用 https。手机摄像头扫码只有在 https 或 localhost 下才能用，
# 所以默认开着；证书是自签名的，首次访问选「继续前往」即可。
HL_HTTPS=true

# ---------------- 账号 ----------------
# 对外访问地址，邮件里的重置密码 / 验证邮箱链接用它拼。对公网开放时务必填写
# HL_PUBLIC_URL=https://books.example.com

# 是否开放注册；false 时只有拿着家庭邀请链接的人能注册（第一个账号不受限制）
HL_ALLOW_REGISTER=true

# 站点管理员邮箱（逗号分隔），能改代理、书目来源、识别引擎等全站设置；
# 不填则第一个注册的账号是管理员
# HL_ADMIN_EMAILS=me@example.com

# 登录有效期（天）
HL_SESSION_DAYS=30

# 放在 nginx / Caddy 等反向代理后面时设置（如 1 或 loopback），限流和 Secure Cookie 才准
# HL_TRUST_PROXY=1

# ---------------- 发信（找回密码、验证邮箱） ----------------
# 不配的话，邮件内容会打印在服务端控制台里。
# 方式一：Brevo 邮件 API（走 https，云平台屏蔽 SMTP 端口时用它），配了就优先用
# HL_BREVO_API_KEY=xkeysib-...
# HL_MAIL_FROM=家庭图书馆 <在 Brevo 验证过的发件邮箱>
# 方式二：SMTP
# HL_SMTP_HOST=smtp.qq.com
# HL_SMTP_PORT=465
# HL_SMTP_SECURE=true
# HL_SMTP_USER=xxx@qq.com
# HL_SMTP_PASS=授权码
# HL_MAIL_FROM=家庭图书馆 <xxx@qq.com>

# 电子书单文件大小上限（MB）
HL_UPLOAD_LIMIT_MB=200

# 数据目录（数据库、封面、电子书都放这儿），默认项目下的 data/
# HL_DATA_DIR=D:/HomeLibraryData

# 下面这些在网页「设置」里也能改，改了以运行时设置为准
# Z-Library 来源默认开关，对外公开的站点建议 false
# HL_ZLIB_ENABLED=true
HL_ZLIB_BASE=https://zh.z-library.sk
HL_GOOGLE_BOOKS_KEY=
