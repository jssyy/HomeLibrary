# 复制成 .env 后按需修改（不改也能跑）

# 服务端口
HL_PORT=8080

# 是否启用 https。手机摄像头扫码只有在 https 或 localhost 下才能用，
# 所以默认开着；证书是自签名的，首次访问选「继续前往」即可。
HL_HTTPS=true

# 家庭访问口令，留空表示局域网内免登录
HL_PIN=

# 电子书单文件大小上限（MB）
HL_UPLOAD_LIMIT_MB=200

# 数据目录（数据库、封面、电子书都放这儿），默认项目下的 data/
# HL_DATA_DIR=D:/HomeLibraryData

# 下面这些在网页「设置」里也能改，改了以运行时设置为准
HL_ZLIB_BASE=https://zh.z-library.sk
HL_GOOGLE_BOOKS_KEY=
